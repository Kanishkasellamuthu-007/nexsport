# ---- NexSport environment variables (EXAMPLE FILE) ----
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file to Git (it is listed in .gitignore).

# Supabase (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Publishable / anon key: safe to use in the FRONTEND.
SUPABASE_ANON_KEY=your-publishable-anon-key-here
# Service-role key: SERVER-SIDE ONLY. Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Legacy symmetric JWT secret (Project Settings -> API -> JWT Secret).
# Only needed if your project uses HS256 tokens; modern projects use RS256.
SUPABASE_JWT_SECRET=

# Flask local development settings
FLASK_PORT=5000
FLASK_DEBUG=1

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# GitHub Models API token for open-source AI sports assistant
# Get a free GitHub Personal Access Token at: https://github.com/settings/tokens
# (no scopes needed for public model inference)
GITHUB_TOKEN=
